{
  "name": "reel-book",
  "version": "0.1.0",
  "description": "Local-first Instagram Reel transcription & knowledge archive",
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "commander": "^15.1.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
