# Copy to .env and fill in
# Get a key at https://aistudio.google.com/apikey
# (Google AI Pro subscription alone is NOT enough — the app calls the API, not the app login)
GEMINI_API_KEY=
GEMINI_FORMAT_MODEL=gemini-3.5-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash
# (gemini-2.5-flash is retired for new users; gemini-3.8-flash is frequently 503 — 3.5-flash verified working)

ARCHIVE_ROOT=./instagram-archive
DATABASE_PATH=./instagram-archive/database/archive.db
SYNC_OVERLAP_DAYS=7

# Optional: custom markdown template (see `pnpm dev init-template`)
ARCHIVE_TEMPLATE_PATH=

# Official Instagram Graph API (only for Business/Creator accounts you have access to)
# Requires a user access token with instagram_business_basic scopes.
GRAPH_ACCESS_TOKEN=
GRAPH_IG_USER_ID=

# Auto git-commit new markdown docs after each sync/process run
ARCHIVE_GIT_AUTOCOMMIT=false

# Opt-in: unofficial media download via yt-dlp (outside Instagram's official APIs).
# Only enable for content you have the right to archive. Default pipeline never uses this.
#ALLOW_UNOFFICIAL_DOWNLOAD=1
# Optional: cookies.txt for login-walled content (yt-dlp --cookies)
#YTDLP_COOKIES_FILE=
